{{ 'sokole-video.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_video  = false
  assign has_poster = false

  if section.settings.video != blank
    assign has_video = true
  elsif section.settings.video_url != blank
    assign has_video = true
  endif

  if section.settings.poster_image != blank
    assign has_poster = true
  endif
-%}

<section class="sokole-video shopify-section">

  {%- if has_video -%}

    {%- if section.settings.video != blank -%}
      <video
        class="sokole-video__video"
        autoplay
        muted
        loop
        playsinline
        {%- if has_poster -%}
          poster="{{ section.settings.poster_image | image_url: width: 1800 }}"
        {%- endif -%}
      >
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>

    {%- elsif section.settings.video_url != blank -%}
      {%- comment -%}
        External URL (e.g. Vimeo CDN direct MP4 link).
        Note: YouTube iframes cannot autoplay without user gesture on most browsers.
        Use a direct .mp4 URL from Vimeo or your own CDN for best results.
      {%- endcomment -%}
      <video
        class="sokole-video__video"
        autoplay
        muted
        loop
        playsinline
        {%- if has_poster -%}
          poster="{{ section.settings.poster_image | image_url: width: 1800 }}"
        {%- endif -%}
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- endif -%}

  {%- elsif has_poster -%}

    {{
      section.settings.poster_image
      | image_url: width: 1800
      | image_tag:
        class: 'sokole-video__poster',
        loading: 'lazy',
        alt: section.settings.heading | default: shop.name | escape
    }}

  {%- else -%}

    <div class="sokole-video__placeholder">
      <div class="sokole-video__placeholder-inner">
        <span class="sokole-video__placeholder-rule"></span>
        <p class="sokole-video__placeholder-title">{{ shop.name }}</p>
        <p class="sokole-video__placeholder-sub">The film — coming soon</p>
      </div>
    </div>

  {%- endif -%}

  <div class="sokole-video__overlay"></div>

  {%- if section.settings.heading != blank or section.settings.overline != blank -%}
    <div class="sokole-video__content">
      {%- if section.settings.overline != blank -%}
        <span class="sokole-video__overline">{{ section.settings.overline }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sokole-video__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="sokole-video__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="sokole-video__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Atmospheric Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify-hosted)",
      "info": "Upload a short atmospheric clip (15–30 s, muted loop). MP4 recommended."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or video URL (.mp4 direct link)",
      "info": "Alternative to uploading — paste a direct .mp4 URL (e.g. from Vimeo CDN). YouTube URLs do not support autoplay."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / fallback image",
      "info": "Shown while the video loads and on devices that block autoplay."
    },
    {
      "type": "header",
      "content": "Text overlay (optional)"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "placeholder": "The Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Atmospheric Video"
    }
  ]
}
{% endschema %}
