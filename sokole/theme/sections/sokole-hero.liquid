{{ 'sokole-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image_url = 'perfume-hero.jpg' | asset_url
  if section.settings.image != blank
    assign hero_image_url = section.settings.image | image_url: width: 1800
  endif
-%}

<section class="sokole-hero shopify-section">
  <div class="sokole-hero__content">
    {%- if section.settings.overline != blank -%}
      <p class="sokole-hero__overline">
        {%- if localization.language.iso_code == 'el' -%}
          Πολυτελή Αρώματα
        {%- else -%}
          {{ section.settings.overline }}
        {%- endif -%}
      </p>
    {%- endif -%}

    <h1 class="sokole-hero__heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.tagline != blank -%}
      <p class="sokole-hero__tagline">
        {%- if localization.language.iso_code == 'el' -%}
          Σπάνια συστατικά. Δημιουργημένα με πρόθεση. Για εκείνους που μπαίνουν σε ένα δωμάτιο και μένουν πολύ αφού φύγουν.
        {%- else -%}
          {{ section.settings.tagline }}
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="sokole-hero__cta">
        {%- if localization.language.iso_code == 'el' -%}
          Ανακαλύψτε τη Συλλογή
        {%- else -%}
          {{ section.settings.button_label }}
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  <div class="sokole-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: section.settings.image.alt | escape
      }}
    {%- else -%}
      <img
        src="{{ 'perfume-hero.jpg' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1400"
        height="933"
      >
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sokole Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Fragrances"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SOKOLE"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Fragrances inspired by elegance, mystery and timeless beauty."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (overrides theme asset)"
    }
  ],
  "presets": [
    {
      "name": "Sokole Hero"
    }
  ]
}
{% endschema %}
