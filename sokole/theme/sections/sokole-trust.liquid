{{ 'sokole-trust.css' | asset_url | stylesheet_tag }}

<section class="sokole-trust shopify-section">
  <div class="page-width sokole-trust__grid">
    {%- for block in section.blocks -%}
      <div class="sokole-trust__item" {{ block.shopify_attributes }}>
        <div class="sokole-trust__icon">
          {%- case block.settings.icon -%}
          {%- when 'leaf' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
            </svg>
          {%- when 'droplet' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
            </svg>
          {%- when 'gift' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 12 20 22 4 22 4 12"/>
              <rect x="2" y="7" width="20" height="5"/>
              <line x1="12" y1="22" x2="12" y2="7"/>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
            </svg>
          {%- when 'lock' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          {%- when 'star' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {%- endcase -%}
        </div>
        <div class="sokole-trust__text">
          {%- if localization.language.iso_code == 'el' -%}
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <span class="sokole-trust__label">Σπάνια Συστατικά</span>
                <span class="sokole-trust__desc">Επιλεγμένα με φροντίδα από όλο τον κόσμο</span>
              {%- when 'droplet' -%}
                <span class="sokole-trust__label">Εκλεπτυσμένα Αρώματα</span>
                <span class="sokole-trust__desc">Δημιουργημένα για να αφηγούνται τη μοναδική σας ιστορία</span>
              {%- when 'gift' -%}
                <span class="sokole-trust__label">Δωρεάν Δείγματα</span>
                <span class="sokole-trust__desc">Με κάθε παραγγελία σας</span>
              {%- when 'lock' -%}
                <span class="sokole-trust__label">Ασφαλής Πληρωμή</span>
                <span class="sokole-trust__desc">Ολοκλήρωση αγοράς με αξιόπιστους συνεργάτες</span>
              {%- else -%}
                <span class="sokole-trust__label">{{ block.settings.label }}</span>
                <span class="sokole-trust__desc">{{ block.settings.description }}</span>
            {%- endcase -%}
          {%- else -%}
            <span class="sokole-trust__label">{{ block.settings.label }}</span>
            <span class="sokole-trust__desc">{{ block.settings.description }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust Icons",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",    "label": "Leaf — Ingredients" },
            { "value": "droplet", "label": "Droplet — Fragrance"  },
            { "value": "gift",    "label": "Gift — Samples"       },
            { "value": "lock",    "label": "Lock — Security"      },
            { "value": "star",    "label": "Star — Premium"       }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trust Point"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short supporting text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Icons",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "leaf",    "label": "Rare Ingredients",       "description": "Sourced with care from around the world" } },
        { "type": "trust_item", "settings": { "icon": "droplet", "label": "Fine Fragrances",         "description": "Crafted to tell your unique story"       } },
        { "type": "trust_item", "settings": { "icon": "gift",    "label": "Complimentary Samples",   "description": "With every order you receive"            } },
        { "type": "trust_item", "settings": { "icon": "lock",    "label": "Secure Payment",          "description": "Safe checkout with trusted partners"     } }
      ]
    }
  ]
}
{% endschema %}
